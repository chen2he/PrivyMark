    "Tap Auto to apply all detected suggestions at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Auto, um alle erkannten Vorschläge auf einmal anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Auto para aplicar todas las sugerencias detectadas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Auto pour appliquer toutes les suggestions détectées d'un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Auto per applicare tutti i suggerimenti rilevati in una volta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Auto para aplicar todas as sugestões detectadas de uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按「自动」即可一次性应用所有识别到的建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「自動」即可一次套用所有辨識到的建議。"
          }
        }
      }
    },
    "Tap a photo to check it. Nothing leaves this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Foto, um es zu prüfen. Nichts verlässt dieses iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una foto para revisarla. Nada sale de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une photo pour la vérifier. Rien ne quitte cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una foto per controllarla. Nulla lascia questo iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma foto para conferir. Nada sai deste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按照片开始检查。照片不会离开这台 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下照片開始檢查。照片不會離開這支 iPhone。"
          }
        }
      }
    },
    "Tap a text line to redact the whole line. Tap again to undo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Textzeile, um die ganze Zeile abzudecken. Erneut tippen zum Widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una línea de texto para taparla entera. Toca de nuevo para deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une ligne de texte pour masquer toute la ligne. Touchez à nouveau pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una riga di testo per coprirla tutta. Tocca di nuovo per annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma linha de texto para ocultá-la inteira. Toque de novo para desfazer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一行文字即可打码整行。再次点按撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下一行文字即可打碼整行。再點一下還原。"
          }
        }
      }
    },
    "Tap a word to cover or reveal it. Only the highlighted words stay redacted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Wort an, um es zu verdecken oder freizugeben. Nur markierte Wörter bleiben geschwärzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una palabra para taparla o mostrarla. Solo las palabras resaltadas siguen ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un mot pour le masquer ou l’afficher. Seuls les mots surlignés restent masqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una parola per coprirla o scoprirla. Restano oscurate solo le parole evidenziate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa palavra para tapá-la ou revelá-la. Só as palavras destacadas ficam ocultas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按词可遮挡或显示。只有高亮的词会被遮挡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按詞可遮擋或顯示。只有標示的詞會被遮擋。"
          }
        }
      }
    },
    "Tap words to cover them. Your picks are redacted on the photo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe Wörter an, um sie abzudecken. Deine Auswahl wird auf dem Foto abgedeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las palabras para taparlas. Tus selecciones se tapan en la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les mots pour les couvrir. Vos choix sont masqués sur la photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le parole per coprirle. Le tue scelte vengono coperte sulla foto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nas palavras para cobri-las. Suas escolhas são ocultadas na foto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按词语即可覆盖。所选内容会在照片上打码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下詞語即可覆蓋。所選內容會在照片上打碼。"
          }
        }
      }
    },
