    "Clears pixel low-bits + all metadata. Can't remove robust forensic watermarks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除像素低位 + 全部元数据。无法去除专业级取证水印。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los bits bajos de los píxeles y todos los metadatos. No elimina marcas de agua forenses robustas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa os bits baixos dos pixels e todos os metadados. Não remove marcas d'água forenses robustas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les bits de poids faible des pixels + toutes les métadonnées. Ne peut pas retirer les filigranes médico-légaux robustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Pixel-Low-Bits und alle Metadaten. Robuste forensische Wasserzeichen bleiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i bit meno significativi dei pixel e tutti i metadati. Non rimuove le filigrane forensi robuste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除像素低位 + 全部中繼資料。無法去除專業級鑑識浮水印。"
