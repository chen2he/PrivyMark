    "Pixelate/blur on text can be reversed. Block is safest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpixeln/Weichzeichnen bei Text ist umkehrbar. Balken ist am sichersten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixelar o difuminar texto se puede revertir. El bloque es lo más seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixelliser/flouter du texte peut être annulé. Le bloc est le plus sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixela/sfoca sul testo può essere annullato. Il blocco è il più sicuro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixelizar/desfocar texto pode ser revertido. Bloco é o mais seguro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字上的马赛克/模糊可能被还原。色块最安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字上的馬賽克/模糊可能被還原。色塊最安全。"
          }
        }
      }
    },
    "Possible hidden watermark — will be scrubbed on export": {
      "localizations": {
        "de": {
