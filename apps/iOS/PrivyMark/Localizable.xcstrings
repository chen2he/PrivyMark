    "No uploads, no account, no tracking. Switch on Airplane Mode and it works just the same.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Upload, kein Konto, kein Tracking. Schalte den Flugmodus ein – alles funktioniert genauso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin subidas, sin cuenta, sin rastreo. Activa el Modo Avión y funciona igual."
