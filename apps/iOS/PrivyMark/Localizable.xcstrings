    "PrivyMark detects private info in a photo — faces, phone numbers, emails, names, card numbers, IDs, license plates — and redacts it for you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 识别照片中的隐私信息——人脸、电话、邮箱、姓名、卡号、证件号、车牌——并帮你打码。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark detecta información privada en una foto — caras, números de teléfono, correos, nombres, números de tarjeta, documentos, matrículas — y la tapa por ti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrivyMark detecta informações privadas em uma foto — rostos, números de telefone, e-mails, nomes, números de cartão, documentos, placas de veículos — e as oculta para você."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark détecte les informations privées dans une photo — visages, numéros de téléphone, e-mails, noms, numéros de carte, pièces d'identité, plaques d'immatriculation — et les masque pour vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark erkennt private Infos in einem Foto – Gesichter, Telefonnummern, E-Mails, Namen, Kartennummern, Ausweise, Kennzeichen – und deckt sie für dich ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark rileva le informazioni private in una foto — volti, numeri di telefono, email, nomi, numeri di carta, documenti, targhe — e le copre al posto tuo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 辨識照片中的隱私資訊——人臉、電話、電子郵件、姓名、卡號、證件號碼、車牌——並幫你打碼。"
          }
        }
      }
    },
    "PrivyMark needs access to your photos so you can pick one to redact.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 需要访问你的照片，以便你选择一张进行打码。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark necesita acceso a tus fotos para que elijas una y la tapes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrivyMark precisa de acesso às suas fotos para você escolher uma e ocultá-la."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark a besoin d'accéder à vos photos pour que vous puissiez en choisir une à masquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark braucht Zugriff auf deine Fotos, damit du eines zum Abdecken auswählen kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark ha bisogno di accedere alle tue foto per permetterti di sceglierne una da coprire."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 需要取用你的照片，以便你選擇一張進行打碼。"
          }
        }
      }
    },
