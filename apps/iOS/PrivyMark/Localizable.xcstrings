    "Uses on-device intelligence to catch names and other sensitive text. Runs 100% on your device — nothing is uploaded. Needs a supported device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt Intelligenz auf dem Gerät, um Namen und andere sensible Texte zu erkennen. Läuft zu 100 % auf deinem Gerät – nichts wird hochgeladen. Erfordert ein unterstütztes Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa inteligencia en el dispositivo para detectar nombres y otros textos sensibles. Se ejecuta 100 % en tu dispositivo; no se sube nada. Requiere un dispositivo compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l'intelligence embarquée pour repérer les noms et autres textes sensibles. S'exécute à 100 % sur votre appareil — rien n'est envoyé. Nécessite un appareil compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'intelligenza sul dispositivo per individuare nomi e altro testo sensibile. Funziona al 100% sul tuo dispositivo: nulla viene caricato. Richiede un dispositivo supportato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa inteligência no dispositivo para captar nomes e outros textos sensíveis. Roda 100% no seu dispositivo — nada é enviado. Requer um dispositivo compatível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用端上智能识别姓名等敏感文字。100% 在你的设备上运行——绝不上传。需要受支持的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用裝置端智慧辨識姓名等敏感文字。100% 在你的裝置上執行——絕不上傳。需要支援的裝置。"
          }
        }
      }
    },
