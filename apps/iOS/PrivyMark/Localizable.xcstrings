    "Location is removed by default. Anything switched off is stripped from the exported copy; the original photo is never changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird standardmäßig entfernt. Alles Ausgeschaltete wird aus der exportierten Kopie entfernt; das Originalfoto bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación se elimina de forma predeterminada. Todo lo que desactives se quita de la copia exportada; la foto original nunca se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est retirée par défaut. Tout ce qui est désactivé est supprimé de la copie exportée ; la photo originale n'est jamais modifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione viene rimossa per impostazione predefinita. Tutto ciò che è disattivato viene eliminato dalla copia esportata; la foto originale non viene mai modificata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização é removida por padrão. Tudo que estiver desativado é removido da cópia exportada; a foto original nunca é alterada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置信息默认移除。关闭的项目会从导出副本中清除；原图始终不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置資訊預設移除。關閉的項目會從匯出副本中清除；原始照片始終不變。"
          }
        }
      }
    },
    "Long-press a detected risk to trim it word by word, or use the text button in the risk list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen erkannten Fund gedrückt, um ihn Wort für Wort zu kürzen – oder nutze die Textschaltfläche in der Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un riesgo detectado para recortarlo palabra por palabra, o usa el botón de texto de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un risque détecté pour le réduire mot à mot, ou utilisez le bouton texte dans la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un rischio rilevato per ridurlo parola per parola, o usa il pulsante testo nell’elenco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha premido um risco detetado para o reduzir palavra a palavra, ou use o botão de texto na lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按检测到的风险即可逐词收窄，也可以用风险清单里的文字按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按偵測到的風險即可逐詞收窄，也可以用風險清單裡的文字按鈕。"
          }
        }
      }
    },
    "Long-press text to explode it into words — tap any word to cover it, or cover the whole line.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Text gedrückt, um ihn in Wörter aufzuteilen – tippe ein Wort an, um es abzudecken, oder decke die ganze Zeile ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el texto para separarlo en palabras; toca cualquier palabra para taparla o tapa la línea entera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur le texte pour l'éclater en mots — touchez un mot pour le couvrir, ou couvrez toute la ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto sul testo per scomporlo in parole: tocca una parola per coprirla oppure copri l'intera riga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o texto pressionado para dividi-lo em palavras — toque em qualquer palavra para cobri-la, ou cubra a linha inteira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按文字将其炸成词块——点按任意词即可覆盖，或覆盖整行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按文字將其炸成詞塊——點一下任意詞即可覆蓋，或覆蓋整行。"
          }
        }
      }
    },
    "Made for the moment before you hit send.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Moment, bevor du auf „Senden“ tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho para el momento antes de enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensé pour l'instant avant d'appuyer sur Envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensato per il momento prima di premere Invia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito para o momento antes de enviar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为按下“发送”前的那一刻而做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為按下「傳送」前的那一刻而做。"
          }
        }
      }
    },
    "Manage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten"
          }
        },
        "es": {
