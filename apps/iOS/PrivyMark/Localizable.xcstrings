    "Allow PrivyMark to access Photos in Settings to save your redacted image.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「设置」中允许 PrivyMark 访问照片，以保存打码后的图片。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que PrivyMark acceda a Fotos en Ajustes para guardar tu imagen tapada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso do PrivyMark às Fotos nos Ajustes para salvar sua imagem ocultada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez PrivyMark à accéder aux Photos dans Réglages pour enregistrer votre image masquée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube PrivyMark in den Einstellungen den Zugriff auf Fotos, um dein abgedecktes Bild zu sichern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a PrivyMark di accedere a Foto in Impostazioni per salvare l'immagine coperta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許 PrivyMark 取用照片，以儲存打碼後的圖片。"
          }
        }
      }
    },
