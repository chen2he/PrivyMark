    "Solid, irreversible cover. Tap the color well to recolor it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckende, unumkehrbare Abdeckung. Tippe auf das Farbfeld, um sie umzufärben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierta sólida e irreversible. Toca el selector de color para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache uni et irréversible. Touchez la pastille de couleur pour le recolorer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copertura piena e irreversibile. Tocca il selettore colore per cambiarne il colore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobertura sólida e irreversível. Toque no seletor de cor para recoloriar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明、不可逆的覆盖。点按色板可更改颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明、不可逆的覆蓋。點一下色板可更改顏色。"
          }
        }
      }
    },
    "Stamp your own text across the image, e.g. \"Internal use only\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präge eigenen Text über das Bild, z. B. „Nur intern“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estampa tu propio texto sobre la imagen, p. ej. «Solo uso interno»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apposez votre propre texte sur l'image, par ex. « Usage interne uniquement »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica un tuo testo sull'immagine, ad es. \"Solo per uso interno\"."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carimbe seu próprio texto sobre a imagem, por exemplo, \"Uso interno apenas\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图片上平铺你自己的文字，例如「仅供内部使用」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在圖片上平鋪你自己的文字，例如「僅供內部使用」。"
          }
        }
      }
    },
    "Stamp your own text across the image.": {
