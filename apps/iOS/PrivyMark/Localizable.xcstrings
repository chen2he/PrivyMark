    "Scanning happens offline. Nothing you open is ever uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描离线进行。你打开的任何内容都不会上传。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se realiza sin conexión. Nada de lo que abras se sube nunca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise acontece offline. Nada do que você abre é enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse se fait hors ligne. Rien de ce que vous ouvrez n'est jamais envoyé."
