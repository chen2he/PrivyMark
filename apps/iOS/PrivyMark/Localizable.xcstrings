    "Tap Auto to apply all detected suggestions at once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按「自动」即可一次性应用所有识别到的建议。"
          }
        }
      }
    },
    "Tap a text line to redact the whole line. Tap again to undo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一行文字即可打码整行。再次点按撤销。"
          }
        }
      }
    },
    "Tap words to cover them. Your picks are redacted on the photo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按词语即可覆盖。所选内容会在照片上打码。"
          }
        }
      }
    },
    "Text Explode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大爆炸"
          }
        }
      }
    },
    "This image contains no EXIF, GPS, or device metadata.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片不含 EXIF、GPS 或设备元数据。"
          }
        }
      }
    },
    "This photo can't be edited in place. Try \"Save a Copy\".": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此照片无法原地编辑。请尝试「保存副本」。"
          }
        }
      }
    },
    "This photo couldn't be downloaded. Check your connection and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此照片无法下载。请检查网络后重试。"
