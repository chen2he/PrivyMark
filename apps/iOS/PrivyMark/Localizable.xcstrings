    "Location is removed by default. Anything switched off is stripped from the exported copy; the original photo is never changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置信息默认移除。关闭的项目会从导出副本中清除；原图始终不变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación se elimina de forma predeterminada. Todo lo que desactives se quita de la copia exportada; la foto original nunca se modifica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização é removida por padrão. Tudo que estiver desativado é removido da cópia exportada; a foto original nunca é alterada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est retirée par défaut. Tout ce qui est désactivé est supprimé de la copie exportée ; la photo originale n'est jamais modifiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird standardmäßig entfernt. Alles Ausgeschaltete wird aus der exportierten Kopie entfernt; das Originalfoto bleibt unverändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione viene rimossa per impostazione predefinita. Tutto ciò che è disattivato viene eliminato dalla copia esportata; la foto originale non viene mai modificata."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置資訊預設移除。關閉的項目會從匯出副本中清除；原始照片始終不變。"
          }
        }
      }
    },
    "Long-press text to explode it into words — tap any word to cover it, or cover the whole line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按文字将其炸成词块——点按任意词即可覆盖，或覆盖整行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el texto para separarlo en palabras; toca cualquier palabra para taparla o tapa la línea entera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o texto pressionado para dividi-lo em palavras — toque em qualquer palavra para cobri-la, ou cubra a linha inteira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur le texte pour l'éclater en mots — touchez un mot pour le couvrir, ou couvrez toute la ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Text gedrückt, um ihn in Wörter aufzuteilen – tippe ein Wort an, um es abzudecken, oder decke die ganze Zeile ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto sul testo per scomporlo in parole: tocca una parola per coprirla oppure copri l'intera riga."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按文字將其炸成詞塊——點一下任意詞即可覆蓋，或覆蓋整行。"
          }
        }
      }
    },
