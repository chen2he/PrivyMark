    "Free, forever. Every scan runs on your device — nothing is ever uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久免费。每次扫描都在你的设备上完成——绝不上传。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis, para siempre. Cada análisis se ejecuta en tu dispositivo; nunca se sube nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis, para sempre. Toda análise roda no seu dispositivo — nada é enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit, pour toujours. Chaque analyse s'exécute sur votre appareil — rien n'est jamais envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer kostenlos. Jeder Scan läuft auf deinem Gerät – nichts wird hochgeladen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis, per sempre. Ogni scansione viene eseguita sul tuo dispositivo: nulla viene mai caricato."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久免費。每次掃描都在你的裝置上完成——絕不上傳。"
          }
        }
      }
    },
    "Free-draw; pick any color or eyedrop from the image.": {
      "localizations": {
