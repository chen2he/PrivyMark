    "Tap Auto to apply all detected suggestions at once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按「自动」即可一次性应用所有识别到的建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Auto para aplicar todas las sugerencias detectadas a la vez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Auto para aplicar todas as sugestões detectadas de uma vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Auto pour appliquer toutes les suggestions détectées d'un coup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Auto, um alle erkannten Vorschläge auf einmal anzuwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Auto per applicare tutti i suggerimenti rilevati in una volta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「自動」即可一次套用所有辨識到的建議。"
          }
        }
      }
    },
    "Tap a text line to redact the whole line. Tap again to undo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一行文字即可打码整行。再次点按撤销。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una línea de texto para taparla entera. Toca de nuevo para deshacer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma linha de texto para ocultá-la inteira. Toque de novo para desfazer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une ligne de texte pour masquer toute la ligne. Touchez à nouveau pour annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Textzeile, um die ganze Zeile abzudecken. Erneut tippen zum Widerrufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una riga di testo per coprirla tutta. Tocca di nuovo per annullare."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下一行文字即可打碼整行。再點一下還原。"
          }
        }
      }
    },
    "Tap words to cover them. Your picks are redacted on the photo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按词语即可覆盖。所选内容会在照片上打码。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las palabras para taparlas. Tus selecciones se tapan en la foto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nas palavras para cobri-las. Suas escolhas são ocultadas na foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les mots pour les couvrir. Vos choix sont masqués sur la photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe Wörter an, um sie abzudecken. Deine Auswahl wird auf dem Foto abgedeckt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le parole per coprirle. Le tue scelte vengono coperte sulla foto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下詞語即可覆蓋。所選內容會在照片上打碼。"
          }
        }
      }
    },
