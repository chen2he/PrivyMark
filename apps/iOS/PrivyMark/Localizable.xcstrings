          }
        }
      }
    },
    "Thanks! This one needs approval before it goes through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! Dieser Kauf muss noch genehmigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Esta compra necesita aprobación antes de completarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Cet achat doit être approuvé avant d’aboutir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie! Questo acquisto deve essere approvato prima di andare a buon fine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado! Esta compra precisa de aprovação antes de ser concluída."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢！这笔还需要批准后才能完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝！這筆還需要核准後才能完成。"
          }
        }
      }
    },
    "That purchase couldn't be verified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht verifiziert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat n’a pas pu être vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’acquisto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这笔购买无法验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆購買無法驗證。"
          }
        }
      }
    },
    "The covered version takes its place in your library. You can revert it later in the Photos app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die abgedeckte Version tritt in deiner Mediathek an seine Stelle. In der Fotos-App kannst du das später rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión tapada ocupa su lugar en tu fototeca. Puedes revertirlo más tarde en la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version masquée la remplace dans votre photothèque. Vous pourrez revenir à l'original plus tard dans l'app Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione coperta prende il suo posto nella libreria. Puoi ripristinarla più tardi nell'app Foto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão oculta substitui a original na sua fototeca. Você pode reverter depois no app Fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打码后的版本会替换图库中的原图。之后可以在“照片”App 中复原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打碼後的版本會取代圖庫中的原圖。之後可以在「照片」App 中復原。"
          }
        }
      }
    },
    "This image carries no GPS, capture or device data. Screenshots and images saved by other apps usually have none; a photo taken with the Camera app normally does.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild enthält keine GPS-, Aufnahme- oder Gerätedaten. Screenshots und von anderen Apps gesicherte Bilder haben meist keine; ein mit der Kamera-App aufgenommenes Foto in der Regel schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen no contiene datos de GPS, captura ni dispositivo. Las capturas de pantalla y las imágenes guardadas por otras apps normalmente no los tienen; una foto hecha con la app Cámara sí suele tenerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image ne contient aucune donnée GPS, de prise de vue ou d’appareil. Les captures d’écran et les images enregistrées par d’autres apps n’en ont généralement pas ; une photo prise avec l’app Appareil photo, si."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa immagine non contiene dati GPS, di scatto o del dispositivo. Gli screenshot e le immagini salvate da altre app di solito non ne hanno; una foto scattata con l’app Fotocamera normalmente sì."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem não contém dados de GPS, captura ou dispositivo. Capturas de tela e imagens salvas por outros apps geralmente não têm; uma foto feita com o app Câmera normalmente tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张图片不含 GPS、拍摄或设备数据。截图和其他 App 保存的图片通常没有；用「相机」拍摄的照片通常有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張圖片不含 GPS、拍攝或裝置資料。截圖和其他 App 儲存的圖片通常沒有；用「相機」拍攝的照片通常有。"
          }
        }
      }
    },
    "This photo can't be edited in place. Try \"Save a Copy\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto kann nicht direkt bearbeitet werden. Versuche „Kopie sichern“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto no se puede editar directamente. Prueba «Guardar una copia»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo ne peut pas être modifiée sur place. Essayez « Enregistrer une copie »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto non può essere modificata in loco. Prova \"Salva una copia\"."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto não pode ser editada no local. Tente \"Salvar uma cópia\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此照片无法原地编辑。请尝试「保存副本」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此照片無法原地編輯。請嘗試「儲存副本」。"
          }
        }
      }
    },
    "This photo couldn't be downloaded. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar esta foto. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n'a pas pu être téléchargée. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare questa foto. Controlla la connessione e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar esta foto. Verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
