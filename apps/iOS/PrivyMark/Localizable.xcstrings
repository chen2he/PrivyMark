    "PrivyMark can only see these. Add more anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark sieht nur diese. Du kannst jederzeit weitere hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark solo ve estas. Añade más cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark ne voit que celles-ci. Ajoutez-en d'autres à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark vede solo queste. Aggiungine altre quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrivyMark só vê estas. Adicione mais quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 只能看到这些，随时可以再添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 只能看到這些，隨時可以再加入。"
          }
        }
      }
    },
    "PrivyMark only reads the photos you open. Share your whole library or just a few — you can change this anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark liest nur die Fotos, die du öffnest. Gib deine ganze Mediathek frei oder nur einige Fotos – das kannst du jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark solo lee las fotos que abres. Comparte toda tu fototeca o solo algunas; puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark ne lit que les photos que vous ouvrez. Partagez toute votre photothèque ou seulement quelques photos — modifiable à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark legge solo le foto che apri. Condividi tutta la libreria o solo alcune foto: puoi cambiarlo quando vuoi in Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrivyMark só lê as fotos que você abre. Compartilhe a fototeca inteira ou só algumas — dá para mudar quando quiser em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 只读取你打开的照片。可以开放整个图库，也可以只选几张——随时都能在“设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 只讀取你打開的照片。可以開放整個圖庫，也可以只選幾張——隨時都能在「設定」中更改。"
          }
        }
      }
    },
    "PrivyMark spots faces, phone numbers, cards, IDs and addresses in a photo — and covers them in one tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark erkennt Gesichter, Telefonnummern, Karten, Ausweise und Adressen auf einem Foto – und deckt sie mit einem Tippen ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark detecta caras, teléfonos, tarjetas, documentos y direcciones en una foto, y los tapa con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark repère les visages, numéros de téléphone, cartes, pièces d'identité et adresses sur une photo — et les masque d'un toucher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark individua volti, numeri di telefono, carte, documenti e indirizzi in una foto, e li copre con un tocco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrivyMark encontra rostos, telefones, cartões, documentos e endereços em uma foto — e oculta tudo com um toque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 能找出照片里的人脸、电话、卡号、证件号和地址，一键盖住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 能找出照片裡的人臉、電話、卡號、證件號碼和地址，一鍵蓋住。"
          }
        }
      }
    },
    "PrivyMark stays free and on-device for everyone. Your coffee keeps it that way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark bleibt für alle kostenlos und läuft auf dem Gerät. Dein Kaffee hält das so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark sigue siendo gratis y funcionando en tu dispositivo para todo el mundo. Tu café ayuda a que siga así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark reste gratuit et fonctionne sur l’appareil, pour tout le monde. Votre café permet que cela continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark resta gratuito e funziona sul dispositivo, per tutti. Il tuo caffè lo mantiene così."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrivyMark continua gratuito e a funcionar no dispositivo para toda a gente. O seu café ajuda a mantê-lo assim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 对所有人都免费，且始终在设备上运行。你的这杯咖啡让它继续如此。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PrivyMark 對所有人都免費，且始終在裝置上執行。你的這杯咖啡讓它繼續如此。"
          }
        }
      }
    },
