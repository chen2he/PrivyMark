    "A delivery label being scanned. The name, face, phone number, address, tracking number and QR code are found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Versandetikett wird gescannt. Name, Gesicht, Telefonnummer, Adresse, Sendungsnummer und QR-Code werden gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se analiza una etiqueta de envío. Se encuentran el nombre, la cara, el teléfono, la dirección, el número de seguimiento y el código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étiquette de livraison est analysée. Le nom, le visage, le numéro de téléphone, l'adresse, le numéro de suivi et le code QR sont détectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'etichetta di spedizione viene analizzata. Vengono trovati nome, volto, numero di telefono, indirizzo, numero di tracciamento e codice QR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta de entrega é analisada. O nome, o rosto, o telefone, o endereço, o código de rastreio e o QR code são encontrados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在扫描一张快递面单。找到了姓名、人脸、电话、地址、运单号和二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在掃描一張宅配單。找到了姓名、人臉、電話、地址、貨態單號和 QR Code。"
          }
        }
      }
    },
    "A delivery label with the name, face, phone number, address, tracking number and QR code covered in green.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Versandetikett, auf dem Name, Gesicht, Telefonnummer, Adresse, Sendungsnummer und QR-Code grün abgedeckt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta de envío con el nombre, la cara, el teléfono, la dirección, el número de seguimiento y el código QR tapados en verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étiquette de livraison dont le nom, le visage, le numéro de téléphone, l'adresse, le numéro de suivi et le code QR sont masqués en vert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'etichetta di spedizione con nome, volto, numero di telefono, indirizzo, numero di tracciamento e codice QR coperti in verde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta de entrega com o nome, o rosto, o telefone, o endereço, o código de rastreio e o QR code ocultos em verde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张快递面单，姓名、人脸、电话、地址、运单号和二维码都已用绿色盖住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一張宅配單，姓名、人臉、電話、地址、貨態單號和 QR Code 都已用綠色蓋住。"
          }
        }
      }
    },
