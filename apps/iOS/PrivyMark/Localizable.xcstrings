    "Photos access is off, so PrivyMark sees only the photo you pick. Turn access on in Settings to browse your library here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fotozugriff ist aus, daher sieht PrivyMark nur das Foto, das du auswählst. Aktiviere den Zugriff in den Einstellungen, um deine Mediathek hier zu durchsuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos está desactivado, así que PrivyMark solo ve la foto que elijas. Actívalo en Ajustes para explorar tu fototeca aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès aux photos est désactivé : PrivyMark ne voit que la photo que vous choisissez. Activez l'accès dans Réglages pour parcourir votre photothèque ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Foto è disattivato, quindi PrivyMark vede solo la foto che scegli. Attiva l'accesso in Impostazioni per sfogliare qui la tua libreria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao Fotos está desativado, então o PrivyMark vê só a foto que você escolher. Ative o acesso em Ajustes para navegar pela sua fototeca aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片访问已关闭，PrivyMark 只能看到你选中的那张照片。在“设置”中开启访问，就能在这里浏览图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片取用權限已關閉，PrivyMark 只能看到你選取的那張照片。在「設定」中開啟權限，就能在這裡瀏覽圖庫。"
          }
        }
      }
    },
    "Pick a photo to scan for faces, text, and hidden marks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Foto, um es nach Gesichtern, Text und versteckten Markierungen zu durchsuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto para buscar caras, texto y marcas ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une photo pour y détecter visages, texte et marques masquées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una foto per cercare volti, testo e marcature nascoste."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto para detectar rostos, texto e marcas ocultas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一张照片，扫描人脸、文字和隐藏标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選一張照片，掃描人臉、文字和隱藏標記。"
          }
        }
      }
    },
    "Pick an emoji from the keyboard, or remove the cover.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
