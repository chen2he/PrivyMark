            "value": "撤销"
          }
        }
      }
    },
    "Uses on-device intelligence to catch names and other sensitive text. Runs 100% on your device — nothing is uploaded. Needs a supported device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用端上智能识别姓名等敏感文字。100% 在你的设备上运行——绝不上传。需要受支持的设备。"
          }
        }
      }
    },
    "View EXIF": {
