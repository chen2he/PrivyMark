# Node / pnpm
node_modules/
.turbo/
.next/
.open-next/

# iOS / Xcode
DerivedData/
xcuserdata/
*.xcuserstate
build/

# Wrangler / Cloudflare
.wrangler/
.dev.vars
!.dev.vars.example

# Environment
.env
.env.local
.env*.local

# OS
.DS_Store

# Local-only design docs + PRD (kept out of the public repo)
docs/
CLAUDE.md

# App Store release tooling (store metadata, screenshots, reviewer info,
# and the screenshot render pipeline) — contains personal review contact
# details and large generated assets; released via fastlane locally, not here.
apps/iOS/fastlane/
apps/iOS/appstore/

# StoreKit config
*.storekit

# Agent / editor local config
.claude/
.agents/

# HarmonyOS (apps/DAMA) — DevEco/hvigor local state and build output
apps/DAMA/.hvigor/
apps/DAMA/.idea/
apps/DAMA/local.properties
apps/DAMA/oh_modules/
apps/DAMA/**/oh_modules/
apps/DAMA/**/build/
apps/DAMA/**/.preview/
apps/DAMA/**/BuildProfile.ets

# AppGallery 上架素材(截图/文案),照 iOS appstore/ 的惯例不入公共仓库
apps/DAMA/appgallery/

# HarmonyOS release signing material — keep private keys out of the repo
apps/DAMA/cert/

# DAMA build-profile carries signing passwords in the material block — keep it local
apps/DAMA/build-profile.json5
